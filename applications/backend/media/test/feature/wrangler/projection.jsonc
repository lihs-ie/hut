{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "hut-media-reference-projection-worker-feature",
  "main": "../../../runtime/media-reference-projection-worker/src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "MEDIA_DATABASE",
      "database_name": "hut-media-feature",
